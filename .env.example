# Local capture and detection need no environment variables or API keys.
# This is a template; vidi does not load .env files automatically.
# For approved user-triggered Gemini requests, use `python -m vidi --save-key`
# once, or `--prompt-key` with a cloud action for a temporary key.
# An exported key takes precedence over the saved key. Never paste a real
# key into a tracked file or chat.
# Setting the key never enables uploads; use --describe or --gemini-detect.
GEMINI_API_KEY=
